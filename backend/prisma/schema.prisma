// Prisma Schema for FastFoodCash (Compatible with SQLite & PostgreSQL)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        String   @id @default(uuid())
  fullName  String
  phone     String   @unique
  pinCode   String
  role      String   @default("CASHIER") // CASHIER, MANAGER, CHEF, STOREKEEPER, ADMIN
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  shifts    Shift[]
  orders    Order[]
  auditLogs AuditLog[]

  @@map("users")
}

model Ingredient {
  id            String   @id @default(uuid())
  name          String
  unit          String   @default("GRAM") // GRAM, KG, LITER, MILLILITER, PIECE
  currentStock  Float    @default(0.0)
  minStockAlert Float    @default(0.0)
  costPerUnit   Float    @default(0.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  recipes       Recipe[]

  @@map("ingredients")
}

model Product {
  id           String   @id @default(uuid())
  categoryName String
  name         String
  price        Float
  imageUrl     String?
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())

  recipes      Recipe[]
  orderItems   OrderItem[]

  @@map("products")
}

model Recipe {
  id               String     @id @default(uuid())
  productId        String
  ingredientId     String
  quantityRequired Float
  wastePercentage  Float      @default(0.0)

  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@map("recipes")
}

model Shift {
  id          String    @id @default(uuid())
  cashierId   String
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  initialCash Float     @default(0.0)
  status      String    @default("OPEN") // OPEN, CLOSED

  cashier     User      @relation(fields: [cashierId], references: [id])
  orders      Order[]
  cashAudit   ShiftCashAudit?

  @@map("shifts")
}

model ShiftCashAudit {
  id            String   @id @default(uuid())
  shiftId       String   @unique
  expectedCash  Float
  declaredCash  Float
  difference    Float
  declaredCard  Float
  declaredQr    Float
  status        String   @default("BALANCED") // BALANCED, SHORTAGE, SURPLUS
  notes         String?
  createdAt     DateTime @default(now())

  shift         Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@map("shift_cash_audits")
}

model Order {
  id          String   @id @default(uuid())
  orderNumber Int
  shiftId     String
  cashierId   String
  totalAmount Float
  paymentType String   @default("CASH") // CASH, CARD, CLICK_PAYME, DELIVERY_PARTNER
  status      String   @default("COMPLETED") // PENDING, COOKING, READY, COMPLETED, CANCELLED
  createdAt   DateTime @default(now())

  shift       Shift    @relation(fields: [shiftId], references: [id])
  cashier     User     @relation(fields: [cashierId], references: [id])
  items       OrderItem[]

  @@map("orders")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  quantity    Int
  unitPrice   Float
  totalPrice  Float

  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  detailsJson String?
  timestamp   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
